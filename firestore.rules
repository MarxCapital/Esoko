rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        (isSignedIn() && request.auth.token.email in ['admin@esoka.com', 'admin@esoko.com', 'ttrfamilypro@gmail.com']) ||
        (request.auth.uid != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read, write: if true;
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // SHOPS COLLECTION
    match /shops/{shopId} {
      allow read, write: if true;
    }

    // CATEGORIES COLLECTION
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read, write: if true;
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // TRANSACTIONS COLLECTION
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // REVIEWS COLLECTION
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // PLATFORM SETTINGS
    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // ADMIN LOGS
    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // SETTINGS HISTORY
    match /settings_history/{historyId} {
      allow read, write: if true;
    }

    // DISPUTES / LITIGES
    match /disputes/{disputeId} {
      allow read, write: if true;
    }

    // DIRECT MESSAGES
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Diagnostic collection test
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
